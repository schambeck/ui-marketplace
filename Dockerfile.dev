FROM node:20-alpine AS build
WORKDIR /usr/src/app-ui-marketplace
COPY package.json package-lock.json ./
RUN npm config set legacy-peer-deps true
RUN npm ci
COPY . .
RUN npm run build:prod

FROM nginx:alpine
COPY --from=build /usr/src/app-ui-marketplace/dist/ui-marketplace /usr/share/nginx/html
COPY certbot/* /etc/nginx/cert/
COPY nginx.dev.conf /etc/nginx/conf.d/default.conf
